@unpublished{simha2026extremebb,
  title       = {Domain-Adapted Text Classification and Causal Estimation under Distribution Shift in Online Communities},
  author      = {Simha, Anagha M V and Pagel, Michaela},
  year        = {2026},
  note        = {Working paper. Manuscript in progress.},
  abstract    = {We study how macroeconomic and platform-level shocks affect posting behavior in extremist online communities. Using the ExtremeBB corpus (36M+ posts, 14 forums, two decades), we fine-tune a DistilBERT classifier to measure economic grievance as a three-class construct and integrate classifier output into a difference-in-differences design. Systematic ablation experiments identify construct instability as the performance bottleneck. A deplatforming analysis finds that only 95 of 200,507 displaced Reddit users migrated to receiving forums, but migrants posted significantly more extreme content (p=0.037).},
  selected    = {true}
}

@unpublished{simha2026hateprism,
  title       = {Proactive Hate Speech Detection Around Major Events},
  author      = {Simha, Anagha M V and Yimam, Seid Muhie and others},
  year        = {2026},
  note        = {In preparation. Lead author. Collaboration with University of Hamburg and IIT Kharagpur.},
  abstract    = {We study temporal spikes in hate speech around major community-affecting events using the HatePRISM dataset. Preliminary findings show a 20\% hate spike beginning 7 days prior to major events.},
  selected    = {false}
}
